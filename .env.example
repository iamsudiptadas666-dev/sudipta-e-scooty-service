# SUPABASE CONFIGURATION
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# VERCEL ENVIRONMENT VARIABLES CONFIGURATION

# GEMINI_API_KEY: Required for Gemini AI EV Diagnosis & Intelligent Service Chatbot.
# Obtain key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The public URL of your Vercel deployment
# Example: https://sudipta-e-scooty.vercel.app
APP_URL="https://your-app-name.vercel.app"

# DELHIVERY LOGISTICS INTEGRATION (Optional)
DELHIVERY_API_KEY="YOUR_DELHIVERY_API_KEY_HERE"
DELHIVERY_TRACKING_URL="https://track.delhivery.com/api/v1/packages/json"

# ENVIRONMENT
NODE_ENV="production"
PORT=3000
